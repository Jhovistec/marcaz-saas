# Copie este arquivo para "config.env" (ou defina as variáveis na Vercel).
# NUNCA suba o config.env para o Git — ele já está no .gitignore.

# ---------- banco ----------
# Em desenvolvimento: SQLite local (não precisa de nada)
MARCAZ_DB=sqlite

# Em produção (Supabase): use a connection string do projeto
# MARCAZ_DB=postgres
# DATABASE_URL=postgresql://postgres.xxxxxx:SENHA@aws-0-xxxx.pooler.supabase.com:6543/postgres
# MARCAZ_PG_SSL=no-verify

# ---------- segurança ----------
# Troque por uma string longa e aleatória. Sem isso, as sessões usam um valor padrão.
MARCAZ_SEGREDO=troque-por-uma-string-aleatoria-bem-longa
